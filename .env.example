# Copie para .env.local e preencha com os dados do seu projeto no Supabase
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
# (ou NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, criada pela integração Vercel + Supabase)

# Endereço público do app (usado nos links de convite e de confirmação de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: protege a rota /api/keepalive (a Vercel envia este segredo nas chamadas agendadas)
CRON_SECRET=
